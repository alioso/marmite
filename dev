#!/usr/bin/env bash
# Day-to-day dev build/run/test — separate from the Release/dist workflow
# (see ./release) so the two never share a build tree or clobber each
# other.
#
# Usage:
#   ./dev          build + relaunch the Standalone app (the default, and
#                   what you want after almost every change)
#   ./dev build    just build, no launch
#   ./dev test     build, then run every JUCE-free engine test, one
#                   pass/fail line per binary
set -euo pipefail
cd "$(dirname "$0")"

APP_NAME="Marmite"
BUILD_DIR="build-dev"
STANDALONE_APP="$BUILD_DIR/MarmiteApp_artefacts/Debug/Standalone/$APP_NAME.app"

configure_if_needed() {
    if [ ! -d "$BUILD_DIR" ]; then
        cmake -S . -B "$BUILD_DIR" -DCMAKE_BUILD_TYPE=Debug
    fi
}

do_build() {
    configure_if_needed
    cmake --build "$BUILD_DIR" -j4
}

do_run() {
    do_build
    pkill -f "MacOS/$APP_NAME" 2>/dev/null || true
    sleep 1
    open "$STANDALONE_APP"
    echo "Launched $STANDALONE_APP"
}

do_test() {
    do_build
    local failed=0
    while IFS= read -r -d '' bin; do
        local name
        name="$(basename "$bin")"
        local log="/tmp/${name}.out"
        if "$bin" >"$log" 2>&1; then
            echo "  PASS  $name"
        else
            echo "  FAIL  $name  (see $log)"
            failed=1
        fi
    done < <(find "$BUILD_DIR" -maxdepth 1 -type f -perm -111 -name "*Test*" -print0 | sort -z)
    if [ "$failed" -eq 0 ]; then
        echo "All tests passed."
    else
        echo "Some tests failed."
        exit 1
    fi
}

case "${1:-run}" in
    build) do_build ;;
    run) do_run ;;
    test) do_test ;;
    *)
        echo "Usage: ./dev [build|run|test]" >&2
        exit 1
        ;;
esac
